<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 🌐 Permisos de red -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>

    <!-- ⚙️ Cámara opcional -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Sistema2"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!-- 🏠 LOGIN (LAUNCHER) -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🗂️ CATEGORÍAS -->
        <activity
            android:name=".ui.categorias.CategoriaActivity"
            android:exported="false"
            android:label="Categorías" />

        <!-- 🛒 PRODUCTOS POR CATEGORÍA (🔥 ESTA FALTABA 🔥) -->
        <activity
            android:name=".ui.productos.ProductosPorCategoriaActivity"
            android:exported="false"
            android:label="Productos" />

        <!-- 🧾 LISTA GENERAL -->
        <activity
            android:name=".ui.productos.ProductoListActivity"
            android:exported="false" />

        <!-- 🔍 DETALLE PRODUCTO -->
        <activity
            android:name=".ui.productos.DetalleProductoActivity"
            android:exported="false" />

        <!-- 👤 PERFIL -->
        <activity
            android:name=".ui.perfil.EditarPerfilActivity"
            android:exported="false" />

        <!-- 🧍 REGISTRO -->
        <activity
            android:name=".ui.register.RegisterActivity"
            android:exported="false" />

        <!-- ⚙️ MAIN -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>
